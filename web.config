<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    
    <!-- 1. Handle Node.js via iisnode (pointing to your compiled TS file) -->
    <handlers>
      <add name="iisnode" path="dist/server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- 2. Rewrite routing to point all dynamic traffic to the Express Node app -->
    <rewrite>
      <rules>
        <rule name="DynamicContent">
          <conditions>
            <!-- Ignore static files if they exist locally -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="dist/server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- 3. Crucial for APIs: Let Express format the 400/404/500 errors. 
         Without this, Plesk/IIS will inject the html error pages instead of your JSON structure. -->
    <httpErrors existingResponse="PassThrough" />

    <iisnode nodeProcessCommandLine="node" watchedFiles="web.config;*.js" />

  </system.webServer>
</configuration>